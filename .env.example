# ============================================
# MovieBox Premium - Environment Configuration
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Server Secrets (Backend only - NEVER expose to client)
TMDB_API_KEY=your_tmdb_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ADMIN_PASSWORD=your_secure_admin_password_here

# Firebase Admin SDK (Backend only)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here"

# Session Security
SESSION_SECRET=your_secure_random_session_secret_here

# App URL
APP_URL=https://moviebox-premium-boxez.vercel.app

# Frontend Public Firebase Configuration (Client-safe)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id