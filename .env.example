PORT=3000
NODE_ENV=development

# ── TMDB ──────────────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_KEY=your_tmdb_api_key_here

# ── Firebase Admin SDK (server-side only) ─────────────────────────────────────
FB_ADMIN_PROJECT_ID=your_firebase_project_id
FB_ADMIN_CLIENT_EMAIL=your_firebase_client_email
FB_ADMIN_PRIVATE_KEY="your_firebase_private_key_here"

# ── Firebase Client SDK (exposed via Vite, browser-safe) ──────────────────────
VITE_FB_API_KEY=your_firebase_api_key_here
VITE_FB_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FB_PROJECT_ID=your_firebase_project_id
VITE_FB_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
VITE_FB_SENDER_ID=your_messaging_sender_id
VITE_FB_APP_ID=your_app_id
VITE_FB_MEASURE_ID=your_measurement_id
VITE_FB_DB_URL=https://your_firebase_project-default-rtdb.firebasedatabase.app

# ── Admin passcode (server-side only) ─────────────────────────────────────────
ADMIN_PASSWORD=your_admin_password_here

# ── App ────────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
SESSION_SECRET=change_me_to_a_random_string